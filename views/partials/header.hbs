<header>
    <div class="container">

        <nav class="navbar">

            <!-- LOGO -->
            <a href="/">
                <img
                    src="/img/tintuc.png"
                    alt="Tin Tức"
                    width="150"
                    class="logo"
                >

            </a>


            <!-- MOBILE BUTTON -->
            <div class="btn-group">

                <button class="theme-btn theme-btn-mobile light">
                    <ion-icon name="moon" class="moon"></ion-icon>
                    <ion-icon name="sunny" class="sun"></ion-icon>
                </button>

                <button class="nav-menu-btn">
                    <ion-icon name="menu-outline"></ion-icon>
                </button>

            </div>


            <!-- DESKTOP -->
            <div class="flex-wrapper">

                <ul class="desktop-nav">

                    <li>
                        <a href="/" class="nav-link">
                            Trang Chủ
                        </a>
                    </li>

                    <li>
                        <a href="/about" class="nav-link">
                            Về Tôi
                        </a>
                    </li>

                    <li>
                        <a href="/contact" class="nav-link">
                            Liên Hệ
                        </a>
                    </li>

                    <li>
                        <a href="/search" class="nav-link">
                            Tìm Kiếm
                        </a>
                    </li>


                    {{#if user}}

                    <!-- ĐÃ ĐĂNG NHẬP -->

                    <li class="nav-item dropdown">

                        <a
                            class="nav-link dropdown-toggle"
                            href="#"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            {{user.username}}
                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a
                                    class="dropdown-item"
                                    href="/blogs/create"
                                >
                                    Tạo Bài Viết
                                </a>
                            </li>

                            <li>
                                <a
                                    class="dropdown-item"
                                    href="/me/stored/blogs"
                                >
                                    Bài Viết Của Tôi
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a
                                    class="dropdown-item"
                                    href="/logout"
                                >
                                    Đăng Xuất
                                </a>
                            </li>

                        </ul>

                    </li>

                    {{else}}

                    <!-- CHƯA ĐĂNG NHẬP -->

                    <li>
                        <a href="/login" class="nav-link">
                            Đăng Nhập
                        </a>
                    </li>

                    <li>
                        <a href="/register" class="nav-link">
                            Đăng Ký
                        </a>
                    </li>

                    {{/if}}

                </ul>


                <!-- DARK MODE -->
                <button class="theme-btn theme-btn-desktop light">
                    <ion-icon name="moon" class="moon"></ion-icon>
                    <ion-icon name="sunny" class="sun"></ion-icon>
                </button>

            </div>


            <!-- MOBILE MENU -->
            <div class="mobile-nav">

                <button class="nav-close-btn">
                    <ion-icon name="close-outline"></ion-icon>
                </button>

                <div class="wrapper">

                    <p class="h3 nav-title">
                        Menu
                    </p>

                    <ul>

                        <li class="nav-item">
                            <a href="/" class="nav-link">
                                Trang Chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/about" class="nav-link">
                                Về Tôi
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/contact" class="nav-link">
                                Liên Hệ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/search" class="nav-link">
                                Tìm Kiếm
                            </a>
                        </li>


                        {{#if user}}

                        <li class="nav-item">
                            <span class="nav-link">
                                Xin chào {{user.username}}
                            </span>
                        </li>

                        <li class="nav-item">
                            <a
                                href="/blogs/create"
                                class="nav-link"
                            >
                                Tạo Bài Viết
                            </a>
                        </li>

                        <li class="nav-item">
                            <a
                                href="/me/stored/blogs"
                                class="nav-link"
                            >
                                Bài Viết Của Tôi
                            </a>
                        </li>

                        <li class="nav-item">
                            <a
                                href="/logout"
                                class="nav-link"
                            >
                                Đăng Xuất
                            </a>
                        </li>

                        {{else}}

                        <li class="nav-item">
                            <a
                                href="/login"
                                class="nav-link"
                            >
                                Đăng Nhập
                            </a>
                        </li>

                        <li class="nav-item">
                            <a
                                href="/register"
                                class="nav-link"
                            >
                                Đăng Ký
                            </a>
                        </li>

                        {{/if}}

                    </ul>

                </div>

            </div>

        </nav>


<!-- ================= THANH CHỦ ĐỀ ================= -->
<!-- CHỈ HIỆN Ở TRANG CHỦ -->

{{#if showTopicBar}}

<div class="topic-bar">

    <div class="topic-container">

        <a href="/" class="topic-item">
            Mới nhất
        </a>

        <a href="/blogs?category=cong-nghe" class="topic-item">
            Công nghệ
        </a>

        <a href="/blogs?category=the-thao" class="topic-item">
            Thể thao
        </a>

        <a href="/blogs?category=giai-tri" class="topic-item">
            Giải trí
        </a>

        <a href="/blogs?category=doi-song" class="topic-item">
            Đời sống
        </a>

        <a href="/blogs?category=bat-dong-san" class="topic-item">
            Bất động sản
        </a>

        <a href="/blogs?category=du-lich" class="topic-item">
            Du lịch
        </a>

        <a href="/blogs?category=suc-khoe" class="topic-item">
            Sức khỏe
        </a>

        <a href="/blogs?category=xe" class="topic-item">
            Xe
        </a>

    </div>

</div>

{{/if}}

    </div>
</header>