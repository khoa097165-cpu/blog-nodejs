{{#unless isCategoryPage}}

<section class="hero">

    <div class="container">

        <div class="left">

            <h1 class="h1">
                Xin Chào <b>Đến Web Tin Tức.</b><br>
            </h1>

            <div class="btn-group">

                <a href="/contact" class="btn btn-primary">
                    Liên hệ
                </a>

                <a href="/about" class="btn btn-secondary">
                    Về tôi
                </a>

            </div>

        </div>

        <div class="right">

            <div class="pattern-bg"></div>

            <div class="img-box">

                <img
                    src="/img/namle1.png"
                    alt="Nam Le"
                    class="hero-img"
                >

                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>

            </div>

        </div>

    </div>

</section>

{{/unless}}


<section class="blog">

    <div class="container">

        <h2 class="h2">
            {{#if selectedCategory}}
                Bài viết: {{selectedCategory}}
            {{else}}
                Danh sách bài viết
            {{/if}}
        </h2>

        <div class="blog-card-group">

            {{#if blogs}}

                {{#each blogs}}

                <div class="blog-card">

                    <div class="blog-card-banner">

                        <img
                            src="{{this.image}}"
                            alt="{{this.name}}"
                            width="250"
                            class="blog-banner-img"
                        >

                    </div>

                    <div class="blog-content-wrapper">

                        <button class="blog-topic text-tiny">
                            {{this.category}}
                        </button>

                        <h3>
                            <a
                                href="/blogs/{{this.slug}}"
                                class="h3"
                            >
                                {{this.name}}
                            </a>
                        </h3>

                        <p class="blog-text">
                            {{this.description}}
                        </p>

                    </div>

                </div>

                {{/each}}

            {{else}}

                <p>Không có bài viết nào thuộc chủ đề này.</p>

            {{/if}}

        </div>


        {{#unless isCategoryPage}}

        <!-- PHÂN TRANG TỰ ĐỘNG -->

        {{#if totalPages}}

        <div class="pagination-wrapper">

            <!-- NÚT TRƯỚC -->
            {{#if (gt currentPage 1)}}

               <a
    href="/?page={{subtract currentPage 1}}"
    class="pagination-next"
    aria-label="Trang trước"
>
    ‹
</a>

            {{/if}}


            <!-- TRANG ĐẦU -->
            {{#if (gt currentPage 3)}}

                <a
                    href="/?page=1"
                    class="pagination-btn"
                >
                    1
                </a>

                <span class="pagination-dots">
                    ...
                </span>

            {{/if}}


            <!-- CÁC TRANG GẦN TRANG HIỆN TẠI -->

            {{#each (paginationPages currentPage totalPages)}}

                {{#if (eq this ../currentPage)}}

                    <a
                        href="/?page={{this}}"
                        class="pagination-btn active"
                    >
                        {{this}}
                    </a>

                {{else}}

                    <a
                        href="/?page={{this}}"
                        class="pagination-btn"
                    >
                        {{this}}
                    </a>

                {{/if}}

            {{/each}}


            <!-- TRANG CUỐI -->

            {{#if (lt currentPage (subtract totalPages 2))}}

                <span class="pagination-dots">
                    ...
                </span>

                <a
                    href="/?page={{totalPages}}"
                    class="pagination-btn"
                >
                    {{totalPages}}
                </a>

            {{/if}}


            <!-- NÚT SAU -->

            {{#if (lt currentPage totalPages)}}

<a
    href="/?page={{add currentPage 1}}"
    class="pagination-next"
    aria-label="Trang sau"
>
    ›
</a>

            {{/if}}

        </div>

        {{/if}}

        {{/unless}}

    </div>

</section>