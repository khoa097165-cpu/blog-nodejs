{{#unless isCategoryPage}}

{{#if blogs}}
{{#with blogs.[0]}}

<section class="featured-news">
    <div class="featured-container">

        <!-- BÊN TRÁI -->
        <div class="featured-content">

            <div class="featured-label">
                <span class="featured-dot"></span>
                TIN NỔI BẬT
            </div>

            <h1 class="featured-title">
                {{title}}
            </h1>

            <p class="featured-description">
                {{description}}
            </p>

<div class="featured-buttons">
    <a href="/blogs/{{slug}}" class="featured-btn featured-btn-primary">
        Xem
    </a>
</div>

        </div>

        <!-- BÊN PHẢI -->
        <div class="featured-image">
            <img src="{{image}}" alt="{{title}}">
        </div>

    </div>
</section>

{{/with}}
{{/if}}

{{/unless}}


<!-- ================= DANH SÁCH BÀI VIẾT ================= -->

<section class="blog">

    <div class="container">

        <h2 class="h2">
            {{#if selectedCategory}}
                Bài viết: {{selectedCategory}}
            {{else}}
                Danh sách bài viết
            {{/if}}
        </h2>


        <div class="blog-card-group">

            {{#if blogs}}

                {{#each blogs}}

                <div class="blog-card">

                    <!-- ẢNH -->
                    <div class="blog-card-banner">

                        <img
                            src="{{this.image}}"
                            alt="{{this.name}}"
                            width="250"
                            class="blog-banner-img"
                        >

                    </div>


                    <!-- NỘI DUNG -->
                    <div class="blog-content-wrapper">

                        <button class="blog-topic text-tiny">
                            {{this.category}}
                        </button>


                        <h3>

                            <a
                                href="/blogs/{{this.slug}}"
                                class="h3"
                            >
                                {{this.name}}
                            </a>

                        </h3>


                        <p class="blog-text">
                            {{this.description}}
                        </p>

                    </div>

                </div>

                {{/each}}

            {{else}}

                <p>
                    Không có bài viết nào thuộc chủ đề này.
                </p>

            {{/if}}

        </div>


        <!-- ================= PHÂN TRANG ================= -->

        {{#unless isCategoryPage}}

        {{#if totalPages}}

        <div class="pagination-wrapper">

            <!-- TRANG TRƯỚC -->
            {{#if (gt currentPage 1)}}

            <a
                href="/?page={{subtract currentPage 1}}"
                class="pagination-next"
                aria-label="Trang trước"
            >
                ‹
            </a>

            {{/if}}


            <!-- TRANG 1 -->
            {{#if (gt currentPage 3)}}

            <a
                href="/?page=1"
                class="pagination-btn"
            >
                1
            </a>

            <span class="pagination-dots">
                ...
            </span>

            {{/if}}


            <!-- TRANG GẦN HIỆN TẠI -->

            {{#each (paginationPages currentPage totalPages)}}

                {{#if (eq this ../currentPage)}}

                <a
                    href="/?page={{this}}"
                    class="pagination-btn active"
                >
                    {{this}}
                </a>

                {{else}}

                <a
                    href="/?page={{this}}"
                    class="pagination-btn"
                >
                    {{this}}
                </a>

                {{/if}}

            {{/each}}


            <!-- TRANG CUỐI -->

            {{#if (lt currentPage (subtract totalPages 2))}}

            <span class="pagination-dots">
                ...
            </span>

            <a
                href="/?page={{totalPages}}"
                class="pagination-btn"
            >
                {{totalPages}}
            </a>

            {{/if}}


            <!-- TRANG SAU -->

            {{#if (lt currentPage totalPages)}}

            <a
                href="/?page={{add currentPage 1}}"
                class="pagination-next"
                aria-label="Trang sau"
            >
                ›
            </a>

            {{/if}}

        </div>

        {{/if}}

        {{/unless}}

    </div>

</section>