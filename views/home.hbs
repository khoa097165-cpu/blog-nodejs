<section class="hero">

    <div class="container">

        <div class="left">

            <h1 class="h1">
                Hi, I'm <b>Nam Lé Biên.</b><br>
                Web Developer
            </h1>

            <p class="h3">
            </p>

            <div class="btn-group">

                <a href="/contact" class="btn btn-primary">
                    Contact Me
                </a>

                <a href="/about" class="btn btn-secondary">
                    About Me
                </a>

            </div>

        </div>

        <div class="right">

            <div class="pattern-bg"></div>

            <div class="img-box">

                <img
                    src="/img/namle1.png"
                    alt="Nam Le"
                    class="hero-img"
                >

                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>

            </div>

        </div>

    </div>

</section>


<section class="blog">

    <div class="container">

        <h2 class="h2">Danh sách bài viết</h2>

        <div class="blog-card-group">

            {{#each blogs}}

            <div class="blog-card">

                <div class="blog-card-banner">

                    <img
                        src="{{this.image}}"
                        alt="{{this.name}}"
                        width="250"
                        class="blog-banner-img"
                    >

                </div>

                <div class="blog-content-wrapper">

                    <button class="blog-topic text-tiny">
                        Database
                    </button>

                    <h3>
                        <a
                            href="/blogs/{{this.slug}}"
                            class="h3"
                        >
                            {{this.name}}
                        </a>
                    </h3>

                    <p class="blog-text">
                        {{this.description}}
                    </p>

                </div>

            </div>

            {{/each}}

        </div>




        </div>

        <!-- PHÂN TRANG -->
        <div class="pagination-wrapper">

            <a href="/?page=1" class="pagination-btn">
                1
            </a>

            <a href="/?page=2" class="pagination-btn">
                2
            </a>

        </div>

    </div>

</section>
    </div>

</section>