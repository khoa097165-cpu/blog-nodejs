<section class="blog-detail">
    <div class="container">

        <h1 class="h1">
            {{blog.name}}
        </h1>

        <div class="blog-detail-layout">

            {{#if blog.image}}
                <div class="blog-detail-image">
                    <img
                        src="{{blog.image}}"
                        alt="{{blog.name}}"
                    >
                </div>
            {{/if}}

            <div class="blog-content">
                <p class="blog-text blog-detail-text">
                    {{blog.description}}
                </p>
            </div>

        </div>

        <a href="/" class="btn btn-secondary" style="margin-bottom: 30px;">
            ← Quay lại
        </a>

    </div>
</section>