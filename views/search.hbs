<div class="container form-container">

    <h2 class="form-title">Tìm kiếm bài viết</h2>

    <form action="/search" method="GET">

        <div class="form-group">
            <label for="search-input">Từ khóa</label>

            <input
                type="text"
                name="q"
                id="search-input"
                class="form-control"
                value="{{keyword}}"
                placeholder="Nhập tên bài viết..."
            >
        </div>

        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>

    </form>

    {{#if keyword}}

        <h3 class="form-title search-title">
            Kết quả cho: "{{keyword}}"
        </h3>

        {{#if blogs}}

            {{#each blogs}}

                <div class="blog-card">

                    {{#if this.image}}
                        <div class="blog-card-banner">
                            <img
                                src="{{this.image}}"
                                alt="{{this.name}}"
                                class="blog-banner-img"
                            >
                        </div>
                    {{/if}}

                    <div class="blog-content-wrapper">

                        <h3 class="h3">
                            {{this.name}}
                        </h3>

                        <p class="blog-text">
                            {{this.description}}
                        </p>

                        <a
                            href="/blogs/{{this.slug}}"
                            class="btn btn-primary"
                        >
                            Xem bài viết
                        </a>

                    </div>

                </div>

            {{/each}}

        {{else}}

            <p class="no-result">
                Không tìm thấy bài viết nào.
            </p>

        {{/if}}

    {{/if}}

</div>