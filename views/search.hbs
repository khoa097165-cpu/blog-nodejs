<div class="container form-container">

    <h2 class="form-title">Tìm kiếm bài viết</h2>

    <form action="/search" method="GET">

        <!-- TỪ KHÓA -->
        <div class="form-group">

            <label for="search-input">
                Từ khóa
            </label>

            <input
                type="text"
                name="q"
                id="search-input"
                class="form-control"
                value="{{keyword}}"
                placeholder="Nhập tên bài viết..."
            >

        </div>


        <!-- CHỦ ĐỀ -->
        <div class="form-group">

            <label for="category">
                Chủ đề
            </label>

            <select
                name="category"
                id="category"
                class="form-control"
            >

                <option value="">
                    -- Chọn chủ đề --
                </option>

                <option value="cong-nghe">
                    Công nghệ
                </option>

                <option value="the-thao">
                    Thể thao
                </option>

                <option value="giai-tri">
                    Giải trí
                </option>

                <option value="doi-song">
                    Đời sống
                </option>

                <option value="kinh-te">
                    Kinh tế
                </option>

                <option value="du-lich">
                    Du lịch
                </option>

                <option value="suc-khoe">
                    Sức khỏe
                </option>

            </select>

        </div>


        <button
            type="submit"
            class="btn btn-primary"
        >
            Tìm kiếm
        </button>

    </form>


    <!-- KẾT QUẢ -->
    {{#if blogs}}

        <h3 class="form-title search-title">
            Kết quả tìm kiếm
        </h3>


        {{#each blogs}}

            <div class="blog-card">

                {{#if image}}

                    <div class="blog-card-banner">

                        <img
                            src="{{image}}"
                            alt="{{name}}"
                            class="blog-banner-img"
                        >

                    </div>

                {{/if}}


                <div class="blog-content-wrapper">

                    <h3 class="h3">
                        {{name}}
                    </h3>

                    <p class="blog-text">
                        {{description}}
                    </p>

                    <a
                        href="/blogs/{{slug}}"
                        class="btn btn-primary"
                    >
                        Xem bài viết
                    </a>

                </div>

            </div>

        {{/each}}


    {{else}}

        {{#if keyword}}

            <p class="no-result">
                Không tìm thấy bài viết nào.
            </p>

        {{else}}

            {{#if category}}

                <p class="no-result">
                    Không tìm thấy bài viết nào trong chủ đề này.
                </p>

            {{/if}}

        {{/if}}

    {{/if}}

</div>