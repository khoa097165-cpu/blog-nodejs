<div class="manage-posts">
    <h3>Quản lý bài viết</h3>

    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>STT</th>
                <th>Tên bài viết</th>
                <th>Ngày tạo</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
            {{#each blogs}}
            <tr>
                <th>{{@index}}</th>

                <td>{{this.name}}</td>

                <td>{{this.createdAt}}</td>

                <td>
                    <div class="actions">
                        <a
                            href="/blogs/{{this._id}}/edit"
                            class="btn btn-primary"
                        >
                            Sửa
                        </a>

                        <form
                            method="POST"
                            action="/blogs/{{this._id}}?_method=DELETE"
                        >
                            <button
                                type="submit"
                                class="btn btn-danger"
                            >
                                Xóa
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>