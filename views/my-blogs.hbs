<div class="manage-posts">
    <h3>Quản lý bài viết</h3>

    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>STT</th>
                <th>Tên bài viết</th>
                <th>Ngày tạo</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
            {{#each blogs}}
            <tr>
                <th>{{@index}}</th>

                <td>{{this.name}}</td>

                <td>
                    <span class="vietnam-date" data-date="{{this.createdAt}}">
                        {{this.createdAt}}
                    </span>
                </td>

                <td>
                    <div class="actions">

                        <a
                            href="/blogs/{{this._id}}/edit"
                            class="btn btn-primary"
                        >
                            Sửa
                        </a>

                        <form
                            method="POST"
                            action="/blogs/{{this._id}}?_method=DELETE"
                        >
                            <button
                                type="submit"
                                class="btn btn-danger"
                            >
                                Xóa
                            </button>
                        </form>

                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>

<script>
document.querySelectorAll(".vietnam-date").forEach(function (element) {

    const date = new Date(element.dataset.date);

    if (!isNaN(date.getTime())) {

        element.textContent = date.toLocaleString("vi-VN", {
            timeZone: "Asia/Ho_Chi_Minh",
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false
        });

    }

});
</script>